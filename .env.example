# Unified form hand-off target. Every CTA and the /application-form route
# send visitors here, carrying their query params + lead_source=apply.
VITE_FORM_URL=https://form.beaconhouse.in/

# stg on staging, prod (or absent) in production. Controls the _stg/_prod
# suffix on Pixel/GA4 event names.
VITE_ENVIRONMENT=prod

# Meta Pixel ID read by the client-side pixel init.
VITE_META_PIXEL_ID=

# Meta CAPI (server-side Netlify function). Note the non-VITE names: the CAPI
# function reads META_PIXEL_ID, NOT VITE_META_PIXEL_ID. Both must be set.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
